# Copy to .env and edit. .env is gitignored; this file is not.
# Every key here has a default in docker-compose.yml, so .env is optional.

# Postgres container and the API connection string must agree on these three.
POSTGRES_USER=timenator
POSTGRES_PASSWORD=timenator
POSTGRES_DB=timenator

# Host ports. Change these if something already listens on 5432 or 6379.
POSTGRES_PORT=5432
REDIS_PORT=6379
