<?xml version="1.0" encoding="utf-8"?>
<!--
One self-contained executable for 64-bit Windows: the .NET runtime is bundled, so the
target machine needs nothing installed. dotnet publish -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Avalonia's native Skia and HarfBuzz libraries go inside the exe as well. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>bin\publish\win-x64\</PublishDir>
  </PropertyGroup>

  <!-- Referenced projects and the SkiaSharp and HarfBuzzSharp packages still drop .pdb files
       next to the exe; they are not needed to run it. -->
  <Target Name="DropSymbols" AfterTargets="Publish">
    <ItemGroup>
      <PublishedSymbols Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishedSymbols)" />
  </Target>
</Project>
