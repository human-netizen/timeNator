<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TimeNator.Desktop.ViewModels"
             x:Class="TimeNator.Desktop.Views.ShellView"
             x:DataType="vm:ShellViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Log out" Command="{Binding LogoutCommand}" />
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FontWeight="SemiBold" />
            </DockPanel>
        </Border>
        <TabControl Padding="0">
            <TabItem Header="Timer" Content="{Binding Timer}" />
            <TabItem Header="History" Content="{Binding History}" />
            <TabItem Header="Subjects" Content="{Binding Subjects}" />
            <TabItem Header="Settings" Content="{Binding Settings}" />
        </TabControl>
    </DockPanel>

</UserControl>
