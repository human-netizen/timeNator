<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TimeNator.Desktop.ViewModels"
             xmlns:dto="using:TimeNator.Shared.Dtos"
             xmlns:conv="using:TimeNator.Desktop.Converters"
             x:Class="TimeNator.Desktop.Views.TimerView"
             x:DataType="vm:TimerViewModel">

    <StackPanel Spacing="18" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
        <ComboBox ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject}"
                  PlaceholderText="Choose a subject" HorizontalAlignment="Stretch"
                  IsEnabled="{Binding IsIdle}">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="dto:SubjectResponse">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="12" Height="12"
                                 Fill="{Binding ColorHex, Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                        <TextBlock Text="{Binding Name}" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" IsVisible="{Binding IsIdle}">
            <ComboBox ItemsSource="{x:Static vm:TimerViewModel.Modes}" SelectedItem="{Binding SelectedMode}"
                      Width="150" />
            <NumericUpDown Value="{Binding CountdownMinutes}" Minimum="1" Maximum="600" Increment="5"
                           FormatString="0" Width="130" IsVisible="{Binding IsCountdown}" />
            <TextBlock Text="min" VerticalAlignment="Center" IsVisible="{Binding IsCountdown}" />
        </StackPanel>

        <TextBlock Text="{Binding ClockText}" FontSize="64" FontWeight="Light" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding DetailText}" HorizontalAlignment="Center" Opacity="0.6" Margin="0,-12,0,0" />

        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
            <Button Content="Start" Command="{Binding StartCommand}" IsVisible="{Binding IsIdle}"
                    MinWidth="90" HorizontalContentAlignment="Center" />
            <Button Content="Pause" Command="{Binding PauseCommand}" IsVisible="{Binding IsRunning}"
                    MinWidth="90" HorizontalContentAlignment="Center" />
            <Button Content="Resume" Command="{Binding ResumeCommand}" IsVisible="{Binding IsPaused}"
                    MinWidth="90" HorizontalContentAlignment="Center" />
            <Button Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding !IsIdle}"
                    MinWidth="90" HorizontalContentAlignment="Center" />
        </StackPanel>

        <TextBlock Text="{Binding Message}" HorizontalAlignment="Center" TextWrapping="Wrap" Opacity="0.8" />

        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"
                    IsVisible="{Binding HasRecovered}">
            <Button Content="Save it" Command="{Binding SaveRecoveredCommand}" />
            <Button Content="Discard" Command="{Binding DiscardRecoveredCommand}" />
        </StackPanel>
    </StackPanel>

</UserControl>
