<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TimeNator.Desktop.ViewModels"
             xmlns:dto="using:TimeNator.Shared.Dtos"
             xmlns:conv="using:TimeNator.Desktop.Converters"
             x:Class="TimeNator.Desktop.Views.SubjectsView"
             x:DataType="vm:SubjectsViewModel">

    <DockPanel Margin="24" Width="520" HorizontalAlignment="Left">
        <StackPanel DockPanel.Dock="Top" Spacing="10">
            <TextBlock Text="Subjects" FontSize="22" FontWeight="SemiBold" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Add" Command="{Binding AddCommand}"
                        IsDefault="True" />
                <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="14" Margin="0,0,8,0"
                        Background="{Binding NewColor, Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                <TextBox PlaceholderText="New subject" Text="{Binding NewName}" />
            </DockPanel>
            <ItemsControl ItemsSource="{x:Static vm:SubjectsViewModel.Palette}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button Width="24" Height="24" CornerRadius="12" Padding="0"
                                Background="{Binding Converter={x:Static conv:HexToBrushConverter.Instance}}"
                                Command="{Binding $parent[UserControl].((vm:SubjectsViewModel)DataContext).PickColorCommand}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap"
                       IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <ScrollViewer Margin="0,16,0,0">
            <ItemsControl ItemsSource="{Binding Subjects}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="dto:SubjectResponse">
                        <DockPanel Margin="0,4">
                            <Button DockPanel.Dock="Right" Content="Archive"
                                    Command="{Binding $parent[UserControl].((vm:SubjectsViewModel)DataContext).DeleteCommand}"
                                    CommandParameter="{Binding}" />
                            <Border Width="14" Height="14" CornerRadius="7" Margin="0,0,10,0"
                                    Background="{Binding ColorHex, Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="15" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>

</UserControl>
