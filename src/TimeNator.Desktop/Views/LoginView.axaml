<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TimeNator.Desktop.ViewModels"
             x:Class="TimeNator.Desktop.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <StackPanel Width="320" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="TimeNator" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBox PlaceholderText="Email" Text="{Binding Email}" />
        <TextBox PlaceholderText="Display name" Text="{Binding DisplayName}" IsVisible="{Binding IsRegistering}" />
        <TextBox PlaceholderText="Password" PasswordChar="•" Text="{Binding Password}" />
        <TextBlock Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Button Content="{Binding SubmitText}" Command="{Binding SubmitCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsDefault="True" />
        <Button Content="{Binding ToggleText}" Command="{Binding ToggleModeCommand}"
                HorizontalAlignment="Center" Background="Transparent" />
    </StackPanel>

</UserControl>
