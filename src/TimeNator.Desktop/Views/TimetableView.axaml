<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TimeNator.Desktop.ViewModels"
             xmlns:dto="using:TimeNator.Shared.Dtos"
             xmlns:conv="using:TimeNator.Desktop.Converters"
             x:Class="TimeNator.Desktop.Views.TimetableView"
             x:DataType="vm:TimetableViewModel">

    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,16">
            <TextBlock Text="Weekly timetable" FontSize="22" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox ItemsSource="{x:Static vm:TimetableViewModel.DayChoices}" SelectedItem="{Binding NewDay}"
                          Width="120" />
                <TimePicker SelectedTime="{Binding NewStart}" ClockIdentifier="24HourClock" MinuteIncrement="5"
                            MinWidth="120" Width="120" />
                <TimePicker SelectedTime="{Binding NewEnd}" ClockIdentifier="24HourClock" MinuteIncrement="5"
                            MinWidth="120" Width="120" />
                <TextBox PlaceholderText="Lecture, lab..." Text="{Binding NewTitle}" Width="170" />
                <ComboBox PlaceholderText="Subject" Width="130" ItemsSource="{Binding Subjects}"
                          SelectedItem="{Binding NewSubject}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="dto:SubjectResponse">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Add" Command="{Binding AddCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding Error}" Foreground="IndianRed"
                       IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Days}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TimetableDay">
                    <Border Margin="3" Padding="6" CornerRadius="6" Background="#0FFFFFFF">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Name}" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Slots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TimetableSlot">
                                        <Border Margin="0,3" Padding="6,4" CornerRadius="4"
                                                BorderThickness="3,0,0,0"
                                                BorderBrush="{Binding ColorHex, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                                                Background="#14FFFFFF">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="×" Padding="4,0" FontSize="11"
                                                        VerticalAlignment="Top"
                                                        Command="{Binding $parent[UserControl].((vm:TimetableViewModel)DataContext).DeleteCommand}"
                                                        CommandParameter="{Binding}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Time}" FontSize="11" Opacity="0.7" />
                                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>

</UserControl>
