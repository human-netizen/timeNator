<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TimeNator.Desktop.ViewModels"
        x:Class="TimeNator.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1000" Height="680" MinWidth="720" MinHeight="480"
        Title="TimeNator">

    <Panel>
        <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding Navigator.Current, Converter={x:Static ObjectConverters.IsNull}}" />
        <ContentControl Content="{Binding Navigator.Current}" />
    </Panel>

</Window>
